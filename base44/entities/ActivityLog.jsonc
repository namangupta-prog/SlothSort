{
  "name": "ActivityLog",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "upload",
        "sample",
        "suggest",
        "approve",
        "reject",
        "undo",
        "export"
      ]
    },
    "title": {
      "type": "string"
    },
    "detail": {
      "type": "string"
    },
    "file_id": {
      "type": "string"
    },
    "file_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "filename": {
      "type": "string"
    },
    "previous": {
      "type": "object"
    },
    "source": {
      "type": "string"
    },
    "undone": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "action"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}